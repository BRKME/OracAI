[Unit]
Description=OracAI LP out-of-range monitor — hourly, 07:00-23:00 MSK

[Timer]
# Ежечасно с 07:00 до 23:00 МСК. Ночью не будим: в 03:00 с выходом позиции
# из диапазона всё равно ничего не сделаешь, а первый утренний прогон в
# 07:00 покажет ситуацию.
# Прогон молчит, если все позиции в диапазоне — гейт в lp_system.py шлёт
# только по алерту. Плановые отчёты 07:00/19:00 не задваиваются: их
# защищает отметка в state/lp_send_state.json.
OnCalendar=*-*-* 07..23:00:00 Europe/Moscow
Persistent=false
AccuracySec=1s
Unit=oracai-dispatch@lp_system.service

[Install]
WantedBy=timers.target
