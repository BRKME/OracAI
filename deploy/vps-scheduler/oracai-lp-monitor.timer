[Unit]
Description=OracAI LP out-of-range monitor — hourly at :30, 07:30-23:30 MSK

[Timer]
# Ежечасно в :30 с 07:30 до 23:30 МСК. Ночью не будим: в 03:00 с выходом
# позиции из диапазона всё равно ничего не сделаешь, а утренний отчёт в
# 07:00 покажет ситуацию.
#
# Смещение на :30 обязательно. На :00 этот таймер совпадал бы с
# oracai-lp-morning (07:00) и oracai-lp-evening (19:00), а они дёргают тот
# же самый сервис. dispatch.sh отрабатывает меньше секунды, поэтому systemd
# не успел бы слить задания: ушло бы два диспатча, оба прогона GitHub
# прочитали бы state до записи «отправлено» — и пришёл бы дубль отчёта.
# Прогон молчит, если все позиции в диапазоне — гейт в lp_system.py шлёт
# только по алерту. Плановые отчёты 07:00/19:00 не задваиваются: их
# защищает отметка в state/lp_send_state.json.
OnCalendar=*-*-* 07..23:30:00 Europe/Moscow
Persistent=false
AccuracySec=1s
Unit=oracai-dispatch@lp_system.service

[Install]
WantedBy=timers.target
